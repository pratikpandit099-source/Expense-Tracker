# ExpenseFlow Backend Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Atlas or local)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/expenseflow?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/expenseflow

# JWT Secrets (Minimum 32 random characters)
JWT_ACCESS_SECRET=expenseflow_super_secret_access_jwt_key_2026_production_grade_32_bytes_min
JWT_REFRESH_SECRET=expenseflow_super_secret_refresh_jwt_key_2026_production_grade_32_bytes_min

# Frontend Client URL (For CORS and secure cookie domain)
CLIENT_URL=http://localhost:5173
