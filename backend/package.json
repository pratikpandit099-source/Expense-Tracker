{
  "name": "expenseflow-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Production-grade backend API for ExpenseFlow - Smart Personal Expense Tracker",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
